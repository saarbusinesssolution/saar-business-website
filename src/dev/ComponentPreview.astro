            <SiteHeader previewIdPrefix="preview-prod" currentPath="/" />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-navy">
              B. Full Intended Navigation Layout (Dev Preview Only)
