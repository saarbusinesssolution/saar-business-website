          <Breadcrumbs
            currentPath="/services/"
            items={[
              { label: 'Services', current: true },
            ]}
          />
        </div>

        <div class="p-4 bg-surface-pure border border-border-subtle rounded-md">
          <span class="text-xs font-mono text-text-muted block mb-2">Example 2: Three-Tier Inner Service Page</span>
