---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import SectionHeader from '../layout/SectionHeader.astro';

interface Props {
  suitableProjectTypes: string[];
  deliverables: string[];
  exclusions?: string[];
  class?: string;
}

const {
  suitableProjectTypes,
  deliverables,
  exclusions = [],
  class: className = '',
} = Astro.props;
---

<Section bg="page" padding="lg" class:list={['border-b border-border-subtle', className]}>
  <Container size="content">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column: Who This Service Is For -->
      <div class="lg:col-span-5 flex flex-col justify-start">
        <div class="sticky top-28">
          <SectionHeader
            eyebrow="Target Applications"
            title="Who This Service Is For"
            lead="Calibrated for clients who demand architectural rigor, clear deliverables, and accountable execution."
          />

          <div class="mt-6 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-navy">
              Supported Project Typologies
            </p>
            <ul class="space-y-2.5 list-none m-0 p-0">
              {suitableProjectTypes.map((type) => (
                <li class="flex items-center gap-3 p-3.5 rounded-sm bg-surface-elevated border border-border-subtle shadow-xs">
                  <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0" aria-hidden="true" />
                  <span class="text-sm font-medium text-brand-charcoal">{type}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Column: Scope Inclusions & Boundaries -->
      <div class="lg:col-span-7 space-y-10">
        <!-- Verified Deliverables -->
        <div class="p-6 sm:p-8 rounded-md bg-surface-elevated border border-border-subtle shadow-card">
          <div class="flex items-center gap-3 mb-6">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-brand-navy text-brand-softwhite text-xs font-mono font-bold">
              ✓
            </span>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-brand-navy m-0">
              Scope & Verified Deliverables
            </h3>
          </div>

          <p class="text-sm text-brand-charcoal/80 mb-6 leading-relaxed">
            Every engagement includes itemized architectural documentation and tangible deliverables codified before commencement.
          </p>

          <ul class="space-y-3.5 list-none m-0 p-0 text-sm text-brand-charcoal">
            {deliverables.map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-brand-gold font-bold shrink-0 mt-0.5" aria-hidden="true">✓</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Scope Boundaries / Exclusions -->
        {exclusions.length > 0 && (
          <div class="p-6 sm:p-8 rounded-md bg-surface-subtle/70 border border-border-subtle">
            <div class="flex items-center gap-2.5 mb-3">
              <svg class="w-4 h-4 text-brand-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
              <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-navy m-0">
                Scope Boundaries & Exclusions
              </h4>
            </div>

            <p class="text-xs text-brand-charcoal/70 mb-4 leading-normal">
              In accordance with architectural transparency standards, the following parameters fall outside standard scope or require licensed external consultant coordination:
            </p>

            <ul class="space-y-2 list-none m-0 p-0 text-xs text-brand-charcoal/85">
              {exclusions.map((exclusion) => (
                <li class="flex items-start gap-2">
                  <span class="text-brand-charcoal/40 select-none font-bold" aria-hidden="true">&ndash;</span>
                  <span>{exclusion}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>
