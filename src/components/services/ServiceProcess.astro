---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import ResponsiveGrid from '../layout/ResponsiveGrid.astro';
import type { ServiceProcessStep } from '../../types/content';

interface Props {
  processSteps: ServiceProcessStep[];
  serviceTitle: string;
  class?: string;
}

const {
  processSteps,
  serviceTitle,
  class: className = '',
} = Astro.props;
---

<Section bg="elevated" padding="lg" class:list={['border-b border-border-subtle', className]}>
  <Container size="content">
    <SectionHeader
      eyebrow="Delivery Methodology"
      title={`${serviceTitle} Execution Stages`}
      lead="A sequenced phase-gated framework ensuring architectural intent is executed without unmanaged cost or timeline creep."
      align="center"
    />

    <ResponsiveGrid cols={processSteps.length > 3 ? 4 : 3} gap="md" class="mt-12">
      {processSteps.map((step) => (
        <div class="flex flex-col justify-between p-6 sm:p-7 rounded-md bg-surface-pure border border-border-subtle hover:border-brand-gold/60 transition-colors shadow-xs relative">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-brand-navy/5 text-brand-gold font-mono text-xs font-bold">
                {step.step < 10 ? `0${step.step}` : step.step}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-widest text-brand-charcoal/50">
                Stage {step.step}
              </span>
            </div>

            <h3 class="font-serif text-lg font-bold text-brand-navy mb-2.5">
              {step.title}
            </h3>

            <p class="text-xs sm:text-sm text-brand-charcoal/80 leading-relaxed">
              {step.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-border-subtle flex items-center justify-between text-[11px] font-medium text-brand-charcoal/60">
            <span>Milestone Gated</span>
            <span class="text-brand-gold">●</span>
          </div>
        </div>
      ))}
    </ResponsiveGrid>
  </Container>
</Section>
