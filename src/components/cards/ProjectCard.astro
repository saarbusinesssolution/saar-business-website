---
import Badge from '../ui/Badge.astro';
import type { ProjectNature } from '../../types/content';

interface Props {
  title: string;
  category: string;
  projectNature: ProjectNature;
  spaceType: string;
  imagePath?: string;
  imageAlt?: string;
  location?: string;
  href?: string;
  class?: string;
}

const {
  title,
  category,
  projectNature,
  spaceType,
  imagePath,
  imageAlt,
  location,
  href,
  class: className = '',
} = Astro.props;

const CardElement = href ? 'a' : 'article';
const isConcept = projectNature === 'concept';
---

<CardElement
  href={href}
  class:list={[
    'flex flex-col bg-surface-elevated border border-border-subtle rounded-md overflow-hidden transition-all duration-200 group relative',
    href ? 'hover:border-brand-gold hover:shadow-card cursor-pointer' : '',
    className,
  ]}
>
  <!-- Architectural Image Frame (16:10 aspect ratio) -->
  <div class="relative w-full aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-border-subtle">
    {imagePath ? (
      <img
        src={imagePath}
        alt={imageAlt || title}
        width="800"
        height="500"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      /* Neutral Architectural Blueprint Placeholder */
      <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-surface-subtle border border-dashed border-border-medium">
        <svg class="w-8 h-8 text-brand-gold/60 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span class="text-xs font-mono uppercase tracking-wider text-text-muted">
          Architectural Study
        </span>
      </div>
    )}

    <!-- Mandatory Nature Classification Badge -->
    <div class="absolute top-3 left-3 z-10">
      {isConcept ? (
        <Badge variant="concept">Design Concept</Badge>
      ) : (
        <Badge variant="verified">Verified Project</Badge>
      )}
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 flex flex-col flex-grow justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-text-muted mb-2">
        <span class="font-semibold uppercase tracking-wider text-brand-navy">
          {category}
        </span>
        {location && (
          <span class="flex items-center gap-1 text-text-muted">
            <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {location}
          </span>
        )}
      </div>

      <h3 class="font-serif text-xl font-semibold text-text-navy group-hover:text-brand-navy transition-colors mb-2">
        {title}
      </h3>

      <p class="text-xs text-text-muted">
        {spaceType}
      </p>
    </div>

    {href && (
      <div class="pt-4 mt-4 border-t border-border-subtle flex items-center justify-between text-xs font-semibold text-brand-navy group-hover:text-brand-gold transition-colors">
        <span>View Case Study</span>
        <span aria-hidden="true" class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
      </div>
    )}
  </div>
</CardElement>
