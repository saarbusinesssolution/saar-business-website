---
interface Props {
  id: string;
  name: string;
  rows?: number;
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  describedBy?: string;
  invalid?: boolean;
  maxlength?: number;
  class?: string;
}

const {
  id,
  name,
  rows = 4,
  placeholder,
  value,
  required = false,
  disabled = false,
  describedBy,
  invalid = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required}
  disabled={disabled}
  aria-describedby={describedBy}
  aria-invalid={invalid ? 'true' : undefined}
  class:list={[
    'w-full p-3.5 text-base sm:text-sm bg-surface-elevated text-text-primary border rounded-sm transition-colors duration-150 resize-y',
    'placeholder:text-text-muted/60',
    'focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-brand-navy',
    invalid
      ? 'border-status-error focus-visible:outline-status-error'
      : 'border-border-subtle hover:border-border-medium',
    disabled ? 'bg-surface-subtle opacity-60 cursor-not-allowed' : '',
    className,
  ]}
  {...rest}
>{value}</textarea>
