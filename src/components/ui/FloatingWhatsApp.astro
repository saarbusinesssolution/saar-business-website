---
/**
 * Accessible, Responsive Floating WhatsApp Action Button.
 * Provides direct WhatsApp enquiry initiation with prefilled message.
 * Respects iOS/Android safe area insets and avoids interfering with key UI landmarks.
 */
import { siteConfig, hasVerifiedWhatsApp, getWhatsAppDirectUrl } from '../../config/site';

interface Props {
  prefilledMessage?: string;
  class?: string;
}

const {
  prefilledMessage = 'Hello SAAR, I would like to enquire about your architectural and turnkey services.',
  class: className = '',
} = Astro.props;

const isAvailable = hasVerifiedWhatsApp(siteConfig);
const waUrl = getWhatsAppDirectUrl(prefilledMessage, siteConfig);
---

{isAvailable && waUrl && (
  <aside
    id="floating-whatsapp-container"
    aria-label="Direct WhatsApp Enquiry"
    class:list={[
      'fixed z-[45] pointer-events-auto transition-transform duration-300 ease-out',
      className,
    ]}
    style="bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px)); right: calc(1.25rem + env(safe-area-inset-right, 0px));"
  >
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with SAAR on WhatsApp (+91 9930321817)"
      data-analytics-contact="whatsapp"
      data-analytics-placement="floating_button"
      class="group relative inline-flex items-center gap-2.5 bg-[#25D366] text-white pl-3.5 pr-4 py-3 rounded-full shadow-elevated hover:bg-[#20bd5a] hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#25D366] transition-all duration-200 select-none min-h-[48px]"
    >
      <!-- Official WhatsApp Icon -->
      <svg
        class="w-5 h-5 fill-current shrink-0 transform group-hover:scale-110 transition-transform duration-200"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
      </svg>

      <!-- Label: Visible on desktop, subtle on mobile -->
      <span class="text-xs font-semibold tracking-wide whitespace-nowrap hidden sm:inline">
        WhatsApp Enquiry
      </span>

      <!-- Ping indicator for organic awareness -->
      <span
        class="absolute -top-1 -right-1 flex h-3.5 w-3.5"
        aria-hidden="true"
      >
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500 border-2 border-white"></span>
      </span>
    </a>
  </aside>
)}

<style>
  :global(body.mobile-nav-open) #floating-whatsapp-container {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: scale(0.9) translateY(12px) !important;
  }
</style>
