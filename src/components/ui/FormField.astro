---
interface Props {
  id: string;
  label: string;
  required?: boolean;
  helpText?: string;
  error?: string;
  class?: string;
}

const {
  id,
  label,
  required = false,
  helpText,
  error,
  class: className = '',
} = Astro.props;

const helpId = helpText ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
---

<div class:list={['flex flex-col mb-5', className]}>
  <div class="flex items-center justify-between mb-1.5">
    <label for={id} class="text-xs font-semibold uppercase tracking-wider text-text-navy">
      {label}
      {required && <span class="text-status-error ml-0.5" aria-hidden="true">*</span>}
    </label>
    {!required && <span class="text-xs text-text-muted">Optional</span>}
  </div>

  <slot />

  {helpText && !error && (
    <p id={helpId} class="text-xs text-text-muted mt-1.5 leading-normal">
      {helpText}
    </p>
  )}

  {error && (
    <p id={errorId} class="text-xs text-status-error mt-1.5 flex items-center gap-1 font-medium leading-normal" role="alert">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      {error}
    </p>
  )}
</div>
