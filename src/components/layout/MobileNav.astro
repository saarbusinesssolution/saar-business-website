---
import type { NavigationItem } from '../../types/content';
import Button from '../ui/Button.astro';
import {
  siteConfig,
  hasVerifiedPhone,
  hasVerifiedWhatsApp,
  getWhatsAppDirectUrl,
} from '../../config/site';

interface Props {
  items: NavigationItem[];
  cta?: NavigationItem | null;
  currentPath?: string;
  idPrefix?: string;
  class?: string;
}

const {
  items,
  cta = null,
  currentPath = Astro.url.pathname,
  idPrefix = 'global',
  class: className = '',
} = Astro.props;

const phoneAvailable = hasVerifiedPhone(siteConfig);
const waAvailable = hasVerifiedWhatsApp(siteConfig);
const waUrl = getWhatsAppDirectUrl(
  'Hello SAAR, I would like to enquire about your architectural and turnkey services.',
  siteConfig
);

const triggerId = `${idPrefix}-mobile-menu-trigger`;
const panelId = `${idPrefix}-mobile-nav-panel`;

function normalize(p: string): string {
  if (!p || p === '/') return '/';
  return p.endsWith('/') ? p : `${p}/`;
}

const normalizedCurrent = normalize(currentPath);

function isExactActive(itemPath: string): boolean {
  return normalize(itemPath) === normalizedCurrent;
}
---

<div class:list={['lg:hidden flex items-center gap-1 sm:gap-2', className]}>
  {phoneAvailable && (
    <a
      href={`tel:${siteConfig.phoneClean || siteConfig.phone?.replace(/[^0-9+]/g, '')}`}
      aria-label={`Call SAAR directly at ${siteConfig.phone}`}
      data-analytics-contact="phone"
      data-analytics-placement="mobile_header"
      class="inline-flex items-center justify-center min-w-[40px] min-h-[40px] p-2 rounded-sm text-brand-navy hover:bg-surface-subtle focus-visible:outline-2 focus-visible:outline-brand-navy transition-colors mr-0.5"
    >
      <svg class="w-5 h-5 text-brand-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
      </svg>
    </a>
  )}

  <!-- Accessible Hamburger Toggle Button -->
  <button
    id={triggerId}
    type="button"
    aria-expanded="false"
    aria-controls={panelId}
    aria-label="Toggle navigation menu"
    class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] p-2.5 rounded-sm text-brand-navy hover:bg-surface-subtle focus-visible:outline-2 focus-visible:outline-brand-navy transition-colors"
  >
    <!-- Hamburger Icon (visible when closed) -->
    <svg
      data-menu-icon="open"
      class="w-6 h-6 block"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.75"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>

    <!-- Close Icon (visible when open) -->
    <svg
      data-menu-icon="close"
      class="w-6 h-6 hidden"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.75"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Expandable Mobile Navigation Panel -->
  <div
    id={panelId}
    hidden
    class="mobile-panel fixed top-20 left-0 right-0 w-full bg-white border-b border-border-subtle shadow-elevated z-[60] h-[calc(100vh-5rem)] h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain"
    style="background-color: #FFFFFF;"
  >
    <nav aria-label="Mobile Navigation" class="p-5 sm:p-6 flex flex-col justify-between min-h-full pb-12 space-y-6">
      <div class="space-y-4">
        {items.length > 0 ? (
          <ul class="flex flex-col divide-y divide-border-subtle list-none m-0 p-0">
            {items.map((item) => {
              const exact = isExactActive(item.path);

              return (
                <li>
                  <a
                    href={item.path}
                    aria-current={exact ? 'page' : undefined}
                    class:list={[
                      'group flex items-center justify-between min-h-[48px] py-3.5 px-3 text-base font-medium rounded-sm transition-colors text-brand-navy hover:text-brand-gold hover:bg-surface-subtle/50',
                      exact && 'font-semibold bg-surface-subtle/70 text-brand-navy',
                    ]}
                  >
                    <span>{item.label}</span>
                    {exact ? (
                      <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0" aria-hidden="true" />
                    ) : (
                      <svg
                        class="w-4 h-4 text-brand-gold/70 shrink-0 transition-transform group-hover:translate-x-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-xs text-brand-charcoal/60 italic py-2">
            Additional site routes are in development.
          </p>
        )}

        {cta && (
          <div class="pt-3">
            <Button
              variant="gold"
              size="md"
              href={cta.path}
              data-analytics-cta="mobile-plan-my-project"
              data-analytics-placement="header"
              class="w-full justify-center shadow-sm font-semibold min-h-[48px]"
            >
              {cta.label}
            </Button>
          </div>
        )}
      </div>

      <!-- Verified Contact Quick Actions -->
      <div class="pt-5 border-t border-border-subtle space-y-3">
        <span class="text-[11px] font-mono uppercase tracking-wider text-brand-gold font-bold block">
          Direct Studio Contact
        </span>

        <div class="grid grid-cols-2 gap-2.5">
          {phoneAvailable && (
            <a
              href={`tel:${siteConfig.phoneClean || siteConfig.phone?.replace(/[^0-9+]/g, '')}`}
              aria-label={`Call SAAR (${siteConfig.phone})`}
              data-analytics-contact="phone"
              data-analytics-placement="mobile_drawer"
              class="inline-flex items-center justify-center gap-1.5 min-h-[48px] py-2.5 px-3 rounded-sm bg-brand-navy text-brand-softwhite text-xs font-semibold hover:bg-brand-navy/90 transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 text-brand-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <span>Call Now</span>
            </a>
          )}

          {waAvailable && waUrl && (
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Enquire with SAAR on WhatsApp"
              data-analytics-contact="whatsapp"
              data-analytics-placement="mobile_drawer"
              class="inline-flex items-center justify-center gap-1.5 min-h-[48px] py-2.5 px-3 rounded-sm bg-[#25D366] text-white text-xs font-semibold hover:bg-[#20bd5a] transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
          )}
        </div>

        {siteConfig.address && (
          <p class="text-[11px] text-brand-charcoal/70 leading-relaxed pt-1">
            <strong class="text-brand-navy block font-semibold">{siteConfig.owner.name} ({siteConfig.owner.designation})</strong>
            {siteConfig.address.formatted}
          </p>
        )}
      </div>
    </nav>
  </div>

  <style>
    .mobile-panel {
      background-color: #FFFFFF !important;
      height: calc(100vh - 5rem);
      height: calc(100dvh - 5rem);
    }
  </style>

  <!-- Progressive Enhancement: No-JS Fallback -->
  <noscript>
    <style>
      .mobile-panel {
        display: block !important;
        position: static !important;
        box-shadow: none !important;
      }
    </style>
  </noscript>
</div>

<script>
  function setupMobileNav() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('button[data-menu-initialized="false"], button[id$="-mobile-menu-trigger"]:not([data-menu-initialized="true"])');

    triggers.forEach((trigger) => {
      trigger.setAttribute('data-menu-initialized', 'true');
      const panelId = trigger.getAttribute('aria-controls');
      if (!panelId) return;

      const panel = document.getElementById(panelId);
      if (!panel) return;

      const openIcon = trigger.querySelector<SVGElement>('[data-menu-icon="open"]');
      const closeIcon = trigger.querySelector<SVGElement>('[data-menu-icon="close"]');

      function getFocusableElements(): HTMLElement[] {
        if (!panel) return [];
        return Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
      }

      function setMenuState(isOpen: boolean) {
        trigger.setAttribute('aria-expanded', String(isOpen));
        trigger.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');

        if (isOpen) {
          panel?.removeAttribute('hidden');
          openIcon?.classList.add('hidden');
          openIcon?.classList.remove('block');
          closeIcon?.classList.add('block');
          closeIcon?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          document.body.classList.add('mobile-nav-open');

          // Move opening focus to first interactive link inside panel
          const focusable = getFocusableElements();
          if (focusable.length > 0) {
            focusable[0].focus();
          }
        } else {
          panel?.setAttribute('hidden', '');
          openIcon?.classList.add('block');
          openIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          closeIcon?.classList.remove('block');
          document.body.style.overflow = '';
          document.body.classList.remove('mobile-nav-open');
        }
      }

      // Toggle menu on trigger click
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyExpanded = trigger.getAttribute('aria-expanded') === 'true';
        setMenuState(!isCurrentlyExpanded);
      });

      // Accessible Tab trapping between trigger and panel focusables
      panel.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const focusable = getFocusableElements();
        if (focusable.length === 0) return;

        const firstElement = focusable[0];
        const lastElement = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstElement) {
            e.preventDefault();
            trigger.focus();
          }
        } else {
          if (document.activeElement === lastElement) {
            e.preventDefault();
            trigger.focus();
          }
        }
      });

      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Tab' && trigger.getAttribute('aria-expanded') === 'true') {
          const focusable = getFocusableElements();
          if (focusable.length === 0) return;

          if (e.shiftKey) {
            e.preventDefault();
            focusable[focusable.length - 1].focus();
          } else {
            e.preventDefault();
            focusable[0].focus();
          }
        }
      });

      // Close menu on link navigation
      const navLinks = panel.querySelectorAll('a');
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setMenuState(false);
        });
      });

      // Close menu on Escape key and restore focus to trigger
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
          setMenuState(false);
          trigger.focus();
        }
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (trigger.getAttribute('aria-expanded') === 'true') {
          const target = e.target as Node;
          if (!panel.contains(target) && !trigger.contains(target)) {
            setMenuState(false);
          }
        }
      });

      // Close cleanly when switching to desktop layout
      const desktopQuery = window.matchMedia('(min-width: 1024px)');
      desktopQuery.addEventListener('change', (e) => {
        if (e.matches && trigger.getAttribute('aria-expanded') === 'true') {
          setMenuState(false);
        }
      });
    });
  }

  // Initialize on page load and Astro view transitions
  setupMobileNav();
  document.addEventListener('astro:page-load', setupMobileNav);
  document.addEventListener('astro:before-swap', () => {
    document.body.style.overflow = '';
    document.body.classList.remove('mobile-nav-open');
  });
</script>
