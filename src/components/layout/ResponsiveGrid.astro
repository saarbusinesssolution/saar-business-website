---
interface Props {
  cols?: 1 | 2 | 3 | 4 | 'auto';
  gap?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  cols = 3,
  gap = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const colsClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
  auto: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-[repeat(auto-fit,minmax(280px,1fr))]',
};

const gapClasses = {
  sm: 'gap-4 md:gap-6',
  md: 'gap-6 md:gap-8',
  lg: 'gap-8 md:gap-12',
};
---

<div
  class:list={[
    'grid w-full',
    colsClasses[cols],
    gapClasses[gap],
    className,
  ]}
  {...rest}
>
  <slot />
</div>
