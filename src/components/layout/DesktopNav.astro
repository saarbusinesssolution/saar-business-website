---
import type { NavigationItem } from '../../types/content';
import Button from '../ui/Button.astro';
import {
  siteConfig,
  hasVerifiedPhone,
  hasVerifiedWhatsApp,
  getWhatsAppDirectUrl,
} from '../../config/site';

interface Props {
  items: NavigationItem[];
  cta?: NavigationItem | null;
  currentPath?: string;
  class?: string;
}

const {
  items,
  cta = null,
  currentPath = Astro.url.pathname,
  class: className = '',
} = Astro.props;

const phoneAvailable = hasVerifiedPhone(siteConfig);
const waAvailable = hasVerifiedWhatsApp(siteConfig);
const waUrl = getWhatsAppDirectUrl(
  'Hello SAAR, I would like to enquire about your architectural and turnkey services.',
  siteConfig
);

/**
 * Normalizes a URL path for reliable exact matching.
 * Preserves root '/' and ensures consistent trailing slash.
 */
function normalize(p: string): string {
  if (!p || p === '/') return '/';
  return p.endsWith('/') ? p : `${p}/`;
}

const normalizedCurrent = normalize(currentPath);

function isExactActive(itemPath: string): boolean {
  return normalize(itemPath) === normalizedCurrent;
}

function isParentActive(itemPath: string): boolean {
  const normItem = normalize(itemPath);
  if (normItem === '/') return false;
  return normalizedCurrent.startsWith(normItem) && normItem !== normalizedCurrent;
}
---

<nav aria-label="Desktop Navigation" class:list={['hidden lg:flex items-center gap-8', className]}>
  {items.length > 0 && (
    <ul class="flex items-center gap-6 xl:gap-8 list-none m-0 p-0">
      {items.map((item) => {
        const exact = isExactActive(item.path);
        const parent = isParentActive(item.path);

        return (
          <li class="relative">
            <a
              href={item.path}
              aria-current={exact ? 'page' : undefined}
              data-parent-active={parent ? 'true' : undefined}
              class:list={[
                'inline-flex items-center min-h-[44px] py-2 px-1 text-sm font-medium transition-colors duration-200 select-none border-b-2',
                exact
                  ? 'text-brand-navy border-brand-gold font-semibold'
                  : parent
                    ? 'text-brand-navy border-brand-gold/40'
                    : 'text-brand-charcoal/80 border-transparent hover:text-brand-navy hover:border-brand-gold/60',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  )}

  <div class="flex items-center gap-2 xl:gap-3 pl-3 border-l border-border-subtle">
    {phoneAvailable && (
      <a
        href={`tel:${siteConfig.phoneClean || siteConfig.phone?.replace(/[^0-9+]/g, '')}`}
        aria-label={`Call SAAR at ${siteConfig.phone}`}
        data-analytics-contact="phone"
        data-analytics-placement="header"
        class="inline-flex items-center gap-1.5 py-1.5 px-2.5 rounded-sm text-xs font-semibold text-brand-navy hover:text-brand-gold hover:bg-surface-subtle/50 transition-colors focus-visible:outline-2 focus-visible:outline-brand-navy"
      >
        <svg class="w-3.5 h-3.5 text-brand-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        <span class="hidden 2xl:inline">{siteConfig.phone}</span>
        <span class="2xl:hidden">Call</span>
      </a>
    )}

    {waAvailable && waUrl && (
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Enquire with SAAR on WhatsApp"
        data-analytics-contact="whatsapp"
        data-analytics-placement="header"
        class="inline-flex items-center gap-1.5 py-1.5 px-2.5 rounded-sm text-xs font-semibold text-emerald-700 hover:text-emerald-800 hover:bg-emerald-50 transition-colors focus-visible:outline-2 focus-visible:outline-emerald-700"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    )}

    {cta && (
      <Button
        variant="gold"
        size="sm"
        href={cta.path}
        data-analytics-cta="header-plan-my-project"
        data-analytics-placement="header"
        class="shadow-sm font-semibold tracking-wide whitespace-nowrap"
      >
        {cta.label}
      </Button>
    )}
  </div>
</nav>
