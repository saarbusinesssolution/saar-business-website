---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import ResponsiveGrid from '../layout/ResponsiveGrid.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import { verifiedDisciplines } from '../../data/home';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Section
  id="services"
  bg="elevated"
  padding="md"
  class:list={['scroll-mt-24', className]}
>
  <Container size="content">
    <SectionHeader
      eyebrow="Core Capabilities"
      title="Architectural & Interior Disciplines"
      lead="Cohesive residential and commercial spatial solutions orchestrated under single-point architectural accountability."
      align="center"
    />

    <ResponsiveGrid cols={3} gap="lg" class="mb-10">
      {verifiedDisciplines.map((item) => (
        <ServiceCard
          orderNumber={item.orderNumber}
          title={item.title}
          shortSummary={item.shortSummary}
          deliverables={item.deliverables}
          imagePath={item.imagePath}
          imageAlt={item.imageAlt}
          href={item.href}
        />
      ))}
    </ResponsiveGrid>

    <!-- Boundary Transparency Note regarding Property Solutions -->
    <div class="max-w-2xl mx-auto p-4 rounded-sm bg-surface-subtle/60 border border-border-subtle text-center">
      <p class="text-xs text-brand-charcoal/70 leading-normal m-0">
        <strong class="text-brand-navy">Scope Notice:</strong> Additional corporate advisory and property feasibility services remain in onboarding and will be introduced following operational verification.
      </p>
    </div>
  </Container>
</Section>
