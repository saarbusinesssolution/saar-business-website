---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import ResponsiveGrid from '../layout/ResponsiveGrid.astro';
import { trustPrinciples } from '../../data/home';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Section
  bg="elevated"
  padding="md"
  class:list={['border-y border-border-subtle', className]}
>
  <Container size="content">
    <SectionHeader
      eyebrow="Our Commitments"
      title="Discipline & Engineering Integrity"
      lead="Architectural credibility is not built on slogans, but on transparent scopes, authentic materiality, and uncompromised site supervision."
      align="center"
    />

    <ResponsiveGrid cols={3} gap="lg">
      {trustPrinciples.map((item) => (
        <div class="p-8 bg-surface-pure rounded-md border border-border-subtle shadow-subtle flex flex-col justify-between">
          <div>
            <span class="font-mono text-xs font-bold text-brand-gold tracking-widest block mb-4">
              PRINCIPLE {item.number}
            </span>
            <h3 class="font-serif text-xl font-bold text-brand-navy mb-3">
              {item.title}
            </h3>
            <p class="text-sm text-brand-charcoal/80 leading-relaxed m-0">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </ResponsiveGrid>
  </Container>
</Section>
