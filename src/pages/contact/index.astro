---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import {
  siteConfig,
  hasVerifiedPhone,
  hasVerifiedEmail,
  hasVerifiedWhatsApp,
} from '../../config/site';
import { getWebPageSchema, getBreadcrumbListSchema } from '../../lib/seo/schema';
import { SITE_URL } from '../../lib/seo/metadata';

const phoneVerified = hasVerifiedPhone();
const emailVerified = hasVerifiedEmail();
const whatsappVerified = hasVerifiedWhatsApp();

const contactStructuredData = [
  getWebPageSchema({
    canonicalUrl: `${SITE_URL}/contact/`,
    title: 'Contact SAAR | Architectural & Turnkey Inquiries',
    description:
      'Initiate a direct consultation regarding architectural space planning, bespoke interior design, or turnkey contracting with SAAR Business Support Solution in Delhi NCR.',
    type: 'ContactPage',
  }),
  getBreadcrumbListSchema([
    { label: 'Home', href: '/' },
    { label: 'Contact', href: '/contact/' },
  ]),
];
---

<BaseLayout
  title="Contact SAAR | Architectural & Turnkey Inquiries"
  description="Initiate a direct consultation regarding architectural space planning, bespoke interior design, or turnkey contracting with SAAR Business Support Solution in Delhi NCR."
  structuredData={contactStructuredData}
>
  <Section class="pt-8 pb-16 lg:pb-24">
    <Container>
      {/* Wayfinding Breadcrumbs */}
      <div class="mb-8">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Contact', href: '/contact/', current: true },
          ]}
        />
      </div>

      {/* Header */}
      <div class="max-w-3xl mb-12">
        <div class="flex items-center gap-2 mb-3">
          <Badge variant="category">Consultation & Enquiries</Badge>
          <span class="text-xs font-mono uppercase tracking-widest text-brand-gold font-semibold">
            Direct Studio Dialogue
          </span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-text-navy tracking-tight mb-4">
          Connect With Our Team
        </h1>
        <p class="text-base sm:text-lg text-text-muted leading-relaxed">
          Whether you are evaluating a residential brief, planning a corporate facility, or seeking single-point turnkey execution, we welcome a focused discussion regarding your space.
        </p>
      </div>

      {/* Main Grid: Form (Left) & Studio Coordinates / Guidance (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        {/* Left Column: Reusable Consultation Enquiry Form */}
        <div class="lg:col-span-7 bg-surface-elevated p-6 sm:p-10 rounded-sm border border-border-subtle shadow-subtle space-y-8">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-brand-gold font-bold block mb-1">
              Project Consultation Form
            </span>
            <h2 class="font-serif text-2xl font-semibold text-text-navy">
              Send a Direct Project Enquiry
            </h2>
            <p class="text-sm text-text-muted mt-1 leading-relaxed">
              Complete the initial details below. We evaluate project scope, location, and technical requirements before arranging an introductory consultation.
            </p>
          </div>

          {/* Form Component */}
          <EnquiryForm id="contact-page-form" mode="standalone" />

          {/* Guided Planner Callout */}
          <div class="p-4 rounded-sm bg-surface-page border border-border-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-xs text-text-muted leading-relaxed">
              <strong class="text-brand-navy block mb-0.5">Need help structuring your requirements?</strong>
              Use our 5-step guided planner to organize your typology, services, and preferences into a structured brief.
            </div>
            <a
              href="/plan-my-project/"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-navy hover:text-brand-gold underline underline-offset-4 flex-shrink-0"
            >
              <span>Open Guided Planner &rarr;</span>
            </a>
          </div>
        </div>

        {/* Right Column: Studio Coordinates, Preparation & Truthful Notice */}
        <div class="lg:col-span-5 space-y-6">
          {/* Direct Coordinates Card */}
          <div class="bg-surface-elevated p-6 sm:p-8 rounded-sm border border-border-subtle shadow-subtle space-y-6">
            <h2 class="font-serif text-xl font-semibold text-text-navy border-b border-border-subtle pb-3">
              Studio Communication
            </h2>

            <div class="space-y-4 text-sm">
              {/* Telephone */}
              <div>
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold block font-semibold mb-1">
                  Telephone Dialogue
                </span>
                {phoneVerified && siteConfig.phone ? (
                  <a
                    href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}
                    class="font-medium text-text-navy hover:text-brand-gold transition-colors"
                  >
                    {siteConfig.phone}
                  </a>
                ) : (
                  <p class="text-xs text-text-muted italic">
                    Direct voice hotline pending administrative verification. Please use the consultation form.
                  </p>
                )}
              </div>

              {/* Email */}
              <div>
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold block font-semibold mb-1">
                  Official Inbound Email
                </span>
                {emailVerified && siteConfig.email ? (
                  <a
                    href={`mailto:${siteConfig.email}`}
                    class="font-medium text-text-navy hover:text-brand-gold transition-colors"
                  >
                    {siteConfig.email}
                  </a>
                ) : (
                  <p class="text-xs text-text-muted italic">
                    Inbound email inquiries are routed securely through our serverless enquiry form.
                  </p>
                )}
              </div>

              {/* WhatsApp */}
              <div>
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold block font-semibold mb-1">
                  Verified WhatsApp Channel
                </span>
                {whatsappVerified && siteConfig.whatsappNumber ? (
                  <a
                    href={`https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-text-navy hover:text-brand-gold transition-colors"
                  >
                    Connect on WhatsApp &rarr;
                  </a>
                ) : (
                  <p class="text-xs text-text-muted italic">
                    WhatsApp direct consultation will activate upon official business registration confirmation.
                  </p>
                )}
              </div>

              {/* Studio Physical Location */}
              <div>
                <span class="text-xs font-mono uppercase tracking-wider text-brand-gold block font-semibold mb-1">
                  Practice Location & Visits
                </span>
                <p class="text-text-primary text-xs leading-relaxed">
                  Delhi NCR, India. Physical studio consultations and comprehensive on-site walk-throughs are arranged by prior appointment following brief qualification.
                </p>
              </div>
            </div>
          </div>

          {/* Consultation Preparation Guide Card */}
          <div class="bg-surface-elevated p-6 sm:p-8 rounded-sm border border-border-subtle shadow-subtle space-y-4">
            <h3 class="font-serif text-lg font-semibold text-text-navy">
              Preparing for Your Discussion
            </h3>
            <p class="text-xs text-text-muted leading-relaxed">
              To make our initial conversation productive, it is helpful (though not mandatory) to have:
            </p>
            <ul class="text-xs text-text-muted space-y-2 list-disc list-inside">
              <li>Approximate carpet / built-up area and spatial category</li>
              <li>Current property possession timeline or handover date</li>
              <li>Broad scope preference: Design-Only vs. Turnkey Execution</li>
              <li>Initial budget expectations for discussion frameworks</li>
            </ul>
            <div class="pt-2 text-[11px] text-text-muted italic border-t border-border-subtle/60">
              * Detailed BoQs, structural evaluations, and municipal sanction documentation are formulated collaboratively with SAAR engineers.
            </div>
          </div>

          {/* Privacy & Zero-Resale Guarantee Card */}
          <div class="p-4 rounded-sm bg-surface-page border border-border-subtle text-xs text-text-muted leading-relaxed">
            <strong class="text-brand-navy block mb-1">Client Confidentiality:</strong>
            All project submissions and site details are held under strict non-disclosure. We do not sell, rent, or distribute client contact information. Review our full data handling policy in our <a href="/privacy/" class="text-brand-navy underline underline-offset-2 hover:text-brand-gold">Privacy Policy</a>.
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
