# ==============================================================================
# SAAR Business Support Solution — Environment Configuration Template
# Copy this file to .env for local development.
# NEVER commit production secrets or live API keys to version control.
# ==============================================================================

# 1. Transactional Email Provider (Resend)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_example_1234567890abcdef

# 2. Verified Sender & Destination Inboxes
# Must be a verified sending domain in Resend (e.g. notifications@saarbusiness.com)
ENQUIRY_SENDER_EMAIL=notifications@saarbusiness.com

# Destination corporate inbox where client briefs and enquiries are delivered
ENQUIRY_RECIPIENT_EMAIL=inquiries@saarbusiness.com

# 3. Spam & Bot Protection (Cloudflare Turnstile)
# Obtain keys from Cloudflare Dashboard > Turnstile
# Local testing uses Cloudflare's official test keypairs:
# Site Key: 1x00000000000000000000AA (Always passes)
# Secret Key: 1x0000000000000000000000000000000AA (Always passes)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 4. Local Development Mock Flag (STRICTLY NON-PRODUCTION)
# Enables safe simulation of email delivery during offline testing without live Resend calls.
# The serverless runtime strictly fails closed if this flag is present in production.
ENABLE_TEST_MOCK_DELIVERY=false

# 5. Privacy-Aware Analytics (Google Analytics 4 — Optional / Public Configuration)
# Public Measurement ID for production GA4 property (Format: G-XXXXXXXXXX).
# Leave empty during local development and preview testing to avoid data pollution.
PUBLIC_GA_MEASUREMENT_ID=

# Explicit Analytics Debug Mode ('true' to enable verbose browser console diagnostics).
# In local development ('npm run dev'), diagnostics are active automatically.
PUBLIC_ANALYTICS_DEBUG=false
