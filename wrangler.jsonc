{
  "name": "saar-business-website",
  "compatibility_date": "2026-09-25",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "saarbusiness.com",
      "custom_domain": true
    },
    {
      "pattern": "www.saarbusiness.com",
      "custom_domain": true
    }
  ]
}
